{
  "name": "nova-arena-server",
  "version": "0.1.0",
  "description": "Server autoritativ Nova Arena (Node + ws) — free-tier friendly",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:ws",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/ws": "^8.5.13",
    "@types/node": "^22.9.0"
  }
}
